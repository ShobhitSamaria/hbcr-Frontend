  DISTANT_METASTASIS                   @map("distant_metastasis")
  NOT_APPLICABLE                       @map("not_applicable")
  RECURRENCE                           @map("recurrence")
  UNKNOWN_PRIMARY                      @map("unknown_primary")
  OTHERS_SPECIFY                       @map("others_specify")
  UNKNOWN                              @map("unknown")

  @@map("hbcr.clinical_extent_enum")
