// =============================================================================
// HBCR Cancer Registry - Prisma schema
// =============================================================================
// Database : PostgreSQL
// Schema   : hbcr
// Maps to  : db.txt (1:1 with the existing HBCR frontend forms)
//
// Conventions:
//   * PostgreSQL enums are declared as Prisma `enum` blocks; each enum is
//     created under the `hbcr` schema via `@@map("hbcr.<enum_name>")`.
//   * Models live under `hbcr` schema via `@@map("hbcr.<table>")`.
//   * Field names use snake_case via `@map("snake_case")` so the generated SQL
//     matches `db.txt` exactly.
//   * `SERIAL` PKs become `Int @id @default(autoincrement())`.
//   * `TIMESTAMPTZ` becomes `DateTime @db.Timestamptz(6)`.
//   * `SMALLINT` becomes `Int @db.SmallInt`.
//   * `NUMERIC(p,s)` becomes `Decimal @db.Decimal(p, s)`.
//   * Composite unique keys use `@@unique([...])`.
//   * Plain indexes use `@@index([...])`.
//   * PostgreSQL CHECK constraints cannot be expressed in Prisma 7 syntax, so
//     they are added manually via prisma/raw_constraints.sql at migration time.
//   * The `pg_trgm` GIN index for fuzzy name search on `patients.full_name`
//     is also added manually in raw_constraints.sql (the generation of the
//     extension plus the index).
//   * Note: Prisma disallows naming an enum identically to a model. The DB
//     enum is still `hbcr.diagnostic_method_enum`; in the Prisma source we
//     name the enum `DiagnosticMethodKind` so it doesn't collide with the
//     `DiagnosticMethod` model.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS  (PostgreSQL enums under hbcr.*)
// =============================================================================

enum Gender {
  MALE   @map("male")
  FEMALE @map("female")
  OTHER  @map("other")

  @@map("hbcr.gender_enum")
}

enum IdType {
  AADHAAR  @map("aadhaar")
  ABHA     @map("abha")
  PAN_CARD @map("pan_card")
  VOTER_ID @map("voter_id")
  PASSPORT @map("passport")
  AB_PMJAY @map("ab_pmjay")
  OTHER    @map("other")

  @@map("hbcr.id_type_enum")
}

enum Relationship {
  FATHER   @map("father")
  MOTHER   @map("mother")
  SPOUSE   @map("spouse")
  SON      @map("son")
  DAUGHTER @map("daughter")
  OTHER    @map("other")

  @@map("hbcr.relationship_enum")
}

enum AddressType {
  RESIDENTIAL @map("residential")
